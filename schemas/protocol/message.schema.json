{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/yyouki/SAMP.AI/main/schemas/protocol/message.schema.json",
  "title": "SAMP.AI Protocol Message",
  "description": "Versioned JSON envelope for requests, responses, and events exchanged between SAMP.AI Core and adapters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "message_id",
    "type",
    "server_instance_id",
    "timestamp"
  ],
  "properties": {
    "protocol": {
      "type": "string",
      "pattern": "^sampai/[0-9]+\\.[0-9]+$"
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "type": {
      "enum": [
        "request",
        "response",
        "event"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "server_instance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "enum": [
            "admin",
            "developer",
            "player",
            "system",
            "service"
          ]
        }
      }
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "event": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "payload": {
      "type": "object"
    },
    "ok": {
      "type": "boolean"
    },
    "result": {},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "details": {
          "type": "object"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "request"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "request_id",
          "actor",
          "action",
          "payload"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "response"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "request_id",
          "ok"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "ok": {
                  "const": true
                }
              },
              "required": [
                "ok"
              ]
            },
            "then": {
              "required": [
                "result"
              ],
              "not": {
                "required": [
                  "error"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "ok": {
                  "const": false
                }
              },
              "required": [
                "ok"
              ]
            },
            "then": {
              "required": [
                "error"
              ],
              "not": {
                "required": [
                  "result"
                ]
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "event"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "event",
          "payload"
        ]
      }
    }
  ]
}
