{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/yyouki/SAMP.AI/main/schemas/protocol/adapter-hello.schema.json",
  "title": "SAMP.AI Adapter Hello Event",
  "description": "Handshake event used by an adapter to identify its runtime and advertise capabilities and limits.",
  "allOf": [
    {
      "$ref": "message.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "event"
        },
        "event": {
          "const": "adapter.hello"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapter",
            "capabilities",
            "limits"
          ],
          "properties": {
            "adapter": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "version",
                "runtime"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "runtime": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "runtime_version": {
                  "type": "string",
                  "maxLength": 80
                }
              }
            },
            "capabilities": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$"
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_operations_per_batch",
                "max_objects_per_project"
              ],
              "properties": {
                "max_operations_per_batch": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "max_objects_per_project": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                }
              }
            }
          }
        }
      },
      "required": [
        "type",
        "event",
        "payload"
      ]
    }
  ]
}
