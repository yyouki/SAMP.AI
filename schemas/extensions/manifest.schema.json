{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/yyouki/SAMP.AI/main/schemas/extensions/manifest.schema.json",
  "title": "SAMP.AI Extension Manifest",
  "description": "Metadata for a declarative extension. It may bind skills to registered tools, but it does not grant permissions or provide executable code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "id",
    "name",
    "version",
    "description",
    "publisher",
    "license",
    "compatibility",
    "entrypoint",
    "skills",
    "tools",
    "permissions_requested",
    "capabilities_required",
    "data_access",
    "network",
    "resources"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 500
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "contact": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "samp_ai_core",
        "protocol_versions"
      ],
      "properties": {
        "samp_ai_core": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "protocol_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
          }
        },
        "adapters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
          }
        }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "file"
      ],
      "properties": {
        "kind": {
          "const": "declarative"
        },
        "file": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "skill.schema.json"
      }
    },
    "tools": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "tool.schema.json"
      }
    },
    "permissions_requested": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$"
      }
    },
    "capabilities_required": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$"
      }
    },
    "data_access": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "project_metadata",
          "project_memory",
          "mapping_data",
          "textdraw_data",
          "server_logs",
          "server_configuration",
          "source_code",
          "database_schema",
          "player_state",
          "player_personal_data"
        ]
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outbound",
        "allowed_hosts",
        "reason"
      ],
      "properties": {
        "outbound": {
          "type": "boolean"
        },
        "allowed_hosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outbound": {
                "const": false
              }
            },
            "required": [
              "outbound"
            ]
          },
          "then": {
            "properties": {
              "allowed_hosts": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_tool_calls_per_run",
        "max_run_seconds",
        "max_context_kb"
      ],
      "properties": {
        "max_tool_calls_per_run": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_run_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "max_context_kb": {
          "type": "integer",
          "minimum": 4,
          "maximum": 2048
        }
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 30
      }
    }
  }
}
